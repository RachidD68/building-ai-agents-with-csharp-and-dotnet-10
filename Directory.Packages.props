<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft Agent Framework — 1.28.0 (dotnet-1.28.0, 2026-11-06) -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Abstractions" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.28.0" />
    <!-- Declarative workflows (YAML). 1.28.0 is on NuGet but not in the offline cache this repo restores from; 1.20.0 is, and runs on Workflows 1.28 (Ch14.WorkflowTests). Re-pin to 1.28.0 when it is restored. -->
    <PackageVersion Include="Microsoft.Agents.AI.Workflows.Declarative" Version="1.20.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Harness" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Foundry" Version="1.28.0-preview.261106.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting" Version="1.28.0-preview.261106.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.A2A" Version="1.28.0-preview.261106.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.A2A.AspNetCore" Version="1.28.0-preview.261106.1" />
    <!-- New provider packages (1.10) -->
    <PackageVersion Include="Microsoft.Agents.AI.Anthropic" Version="1.28.0" />
    <!-- Foundry upstream: Azure AI Projects client used by AIProjectClient.AsAIAgent(...).
         3.0.0-beta.5 = the floor Microsoft.Agents.AI.Foundry 1.28.0-preview requires (major bump from 2.x). -->
    <PackageVersion Include="Azure.AI.Projects" Version="3.0.0-beta.5" />
    <!-- AI Abstractions & Providers -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <!-- Evaluation (Ch21.EvalTests harness / Ch21.EvalSuite) -->
    <PackageVersion Include="Microsoft.Extensions.AI.Evaluation" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Evaluation.Quality" Version="10.11.0" />
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="OllamaSharp" Version="5.4.25" />
    <!-- Tokenizers (Ch02.TokenExplorer — real BPE token counts, offline) -->
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <!-- MCP -->
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <!-- Ch09.ProtectedMcpServer: the MCP endpoint as an OAuth resource server (same 10.0.13 servicing line as Hosting) -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <!-- Vector Data / RAG -->
    <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.10.0" />
    <PackageVersion Include="CommunityToolkit.VectorData.InMemory" Version="1.0.1" />
    <!-- Observability (MAF 1.22 raises the OpenTelemetry.Api floor to 1.18.0) -->
    <PackageVersion Include="OpenTelemetry" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <!-- SQLite: the one pin for every sample that keeps state in a SQLite file
         (operation store, outbox and delivery journal of the authorized-actions chapter
         and its Contoso snapshot). Microsoft.Data.Sqlite.Core 10.0.13 needs
         SQLitePCLRaw.core 2.1.13, so the native bundle is pinned at the same 2.1.13. -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.13" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <!-- Hosting -->
    <PackageVersion Include="Aspire.Hosting" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.5" />
    <!-- Resilience -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
    <PackageVersion Include="Microsoft.Extensions.Resilience" Version="10.7.0" />
    <!-- Security fixes for vulnerable transitive dependencies -->
    <!-- Microsoft.ML.Tokenizers 2.0.0 pulls Microsoft.Bcl.Memory 9.0.4 (GHSA-73j8-2gch-69rq); bump to a safe version. -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.9" />
    <!-- Microsoft.Identity.Web 4.x pulls System.Security.Cryptography.Pkcs 10.0.7-10.0.10 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Not resolved by any project: no packages.lock.json contains these three. The Aspire AppHost, which
         pulls them in, opts out of central versions and pins its own (HealthChecks 10.0.14, MessagePack 3.1.12,
         Grpc.Tools 2.83.0). -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.5" />
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="Grpc.Tools" Version="2.78.0" />
    <!-- Common: stable .NET 10 servicing builds (were 11.0.0-preview.3 by mistake; the book targets .NET 10 LTS) -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <!-- ── Phase 2 chapter packages (1.10) ──────────────────────────── -->
    <!-- Ch20.ContentSafety — Azure AI Content Safety (input/output moderation) -->
    <PackageVersion Include="Azure.AI.ContentSafety" Version="1.0.0" />
    <!-- Ch19.OpenTelemetryAgent — Azure Monitor (Application Insights) OpenTelemetry exporter -->
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.8.1" />
    <!-- Ch17.AspNetCoreHost — Microsoft Identity Web for securing the hosted agent endpoint -->
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.10.0" />
  </ItemGroup>
</Project>