<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- One user-secrets store for every sample, so a key set once works in
         every chapter: dotnet user-secrets set "LlmProvider:OpenAI:ApiKey" "<key>"
         (run it from any project folder; no "user-secrets init" needed). -->
    <UserSecretsId>building-ai-agents-dotnet10</UserSecretsId>
    <!-- Running a sample from the repo root (dotnet run with the project option)
         still runs it in its own folder, so its appsettings.json is the one that loads. -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>
  <!-- Reproducible restores: every project commits a packages.lock.json, and CI
       restores with locked mode so a changed dependency graph fails the build.
       Refresh after a version change with: dotnet restore AgenticAI.slnx
       The Aspire AppHost is excluded: its SDK pulls OS-specific packages
       (dashboard and orchestration binaries per platform), so one lock file
       cannot serve Windows, Linux and macOS. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.AppHost'))">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
