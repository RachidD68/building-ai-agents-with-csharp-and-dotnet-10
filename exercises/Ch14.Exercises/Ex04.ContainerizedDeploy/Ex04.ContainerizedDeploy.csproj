<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- ====================================================================
         SDK container publishing (.NET 10): `dotnet publish /t:PublishContainer`.
         No Dockerfile and no NuGet package required; these properties shape the
         produced OCI image. The chiseled Ubuntu runtime is small, ships no shell
         or package manager, and runs as a non-root user by default. A Dockerfile
         is also included for teams that require one in source control.
         ==================================================================== -->
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled</ContainerBaseImage>
    <ContainerRepository>ch13-ex04-agent-api</ContainerRepository>
    <ContainerImageTags>1.0.0;latest</ContainerImageTags>
    <ContainerImageFormat>OCI</ContainerImageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <!-- Microsoft.Identity.Web brings Microsoft.AspNetCore.Authentication.JwtBearer
         in transitively, so a bare AddJwtBearer() works without a separate pin. -->
    <PackageReference Include="Microsoft.Identity.Web" />
    <!-- Bump the vulnerable System.Security.Cryptography.Pkcs that Identity.Web pulls in (GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="OllamaSharp" />
  </ItemGroup>

</Project>
