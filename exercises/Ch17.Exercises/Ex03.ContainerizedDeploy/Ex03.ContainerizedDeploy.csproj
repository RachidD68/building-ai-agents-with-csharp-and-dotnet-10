<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A deployable agent API: bearer auth, a (tenant, subject) rate limit, and
       an image with no secret in any layer. GA packages only. TestHost is used
       by the self-test only (check-image.ps1 runs it inside the image too). -->
  <PropertyGroup>
    <!-- SDK container publishing (.NET 10): dotnet publish /t:PublishContainer.
         The chiseled Ubuntu runtime ships no shell or package manager and runs
         as a non-root user by default. -->
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled</ContainerBaseImage>
    <ContainerRepository>ch17-ex03-agent-api</ContainerRepository>
    <ContainerImageTags>1.0.0;latest</ContainerImageTags>
    <ContainerImageFormat>OCI</ContainerImageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Common/AgenticAI.Common/AgenticAI.Common.csproj" />
  </ItemGroup>

</Project>
