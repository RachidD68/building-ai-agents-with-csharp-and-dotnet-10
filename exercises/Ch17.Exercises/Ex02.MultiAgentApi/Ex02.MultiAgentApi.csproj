<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Four keyed agents, a discovery route and one owned conversational route
       behind a bearer token. Microsoft.Agents.AI.Hosting (AddAIAgent) is a
       preview package. TestHost is used by the self-test only. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Common/AgenticAI.Common/AgenticAI.Common.csproj" />
  </ItemGroup>

</Project>
