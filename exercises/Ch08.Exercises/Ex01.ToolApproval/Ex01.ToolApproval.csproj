<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- ToolApprovalAgent, ToolApprovalAgentOptions and ApprovalRequiredAIFunction carry
         no [Experimental] attribute in Microsoft.Agents.AI 1.28.0 / Microsoft.Extensions.AI
         10.11.0, so no suppression is needed. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- The GA-only provider switch (Ollama by default) and the policy checked before approval. -->
    <ProjectReference Include="../../../src/Common/AgenticAI.Common/AgenticAI.Common.csproj" />
    <ProjectReference Include="../../../src/Ch08.AuthorizedActions/Ch08.ActionPolicy/Ch08.ActionPolicy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
