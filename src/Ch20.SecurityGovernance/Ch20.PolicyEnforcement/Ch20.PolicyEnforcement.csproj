<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The decision point at the effect, reached from four transports: an HTTP
       API (Kestrel on 127.0.0.1), an MCP tool (ModelContextProtocol, in-memory
       pipes), and agent runs shaped like the A2A and AG-UI hosts. GA packages
       only: the A2A and AG-UI hosting packages are preview, so the test drives
       the agent run those hosts would make. No model, no API key. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ch08's deterministic reimbursement policy: the baseline rules. -->
    <ProjectReference Include="../../Ch08.AuthorizedActions/Ch08.ActionPolicy/Ch08.ActionPolicy.csproj" />
    <!-- Scripted model for the agent-host paths. -->
    <ProjectReference Include="../../Common/AgenticAI.Testing/AgenticAI.Testing.csproj" />
  </ItemGroup>

</Project>
