<Project Sdk="Microsoft.NET.Sdk">

  <!-- Model output treated as untrusted input at three sinks: HTML, Markdown
       links and images, and SQL (a real in-memory SQLite database). No model. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Data.Sqlite.Core is the ADO.NET provider; the bundle supplies
         the native SQLite library for Windows, Linux and macOS. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <!-- Markdig parses the answer the way a Markdown renderer would. -->
    <PackageReference Include="Markdig" />
  </ItemGroup>
</Project>
