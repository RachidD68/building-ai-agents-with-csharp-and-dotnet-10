<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cost per accepted task from measured UsageDetails and a price table
       supplied as data. No model, no network. Only the GA abstractions:
       UsageDetails (InputTokenCount, OutputTokenCount, CachedInputTokenCount,
       ReasoningTokenCount) carries no [Experimental] attribute in
       Microsoft.Extensions.AI.Abstractions 10.11.0 (checked by reflection).
       LoadProfile and ModelRouting reference this project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="data/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
