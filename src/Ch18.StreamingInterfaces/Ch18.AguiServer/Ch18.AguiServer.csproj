<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Contoso assistant over AG-UI (MapAGUI), behind JWT bearer, with the
       operation's state on the GA status stream and approvals on the review
       routes. PREVIEW: Microsoft.Agents.AI.Hosting.AGUI.AspNetCore
       1.5.0-preview is the only AG-UI build in the offline cache, and it needs
       Microsoft.Agents.AI.Hosting 1.5.0-preview (overridden below): against
       Hosting 1.28 MapAGUI throws TypeLoadException (AgentSessionStore moved).
       So this host cannot share a process with Contoso v6 (Hosting 1.28); the
       GA alternative is Ch18.SseStatusStream, which v6 maps. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);MAAI001;MEAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting" VersionOverride="1.5.0-preview.260507.1" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Common/AgenticAI.Common/AgenticAI.Common.csproj" />
    <ProjectReference Include="../Ch18.SseStatusStream/Ch18.SseStatusStream.csproj" />
    <ProjectReference Include="../Ch18.ApprovalUi/Ch18.ApprovalUi.csproj" />
  </ItemGroup>

</Project>
