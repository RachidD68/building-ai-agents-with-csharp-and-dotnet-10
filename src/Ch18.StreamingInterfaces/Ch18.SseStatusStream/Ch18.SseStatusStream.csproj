<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The interface chapter's GA path: the operation's state, the response's
       text and tool status as separate, typed Server-Sent Events, with a resume
       cursor, a versioned snapshot and a bounded queue per client.
       TypedResults.ServerSentEvents and SseItem<T> are in .NET 10 itself; no
       preview package. Contoso v6 and the other ch18 projects reference this
       one for the contract (OperationLog, StatusEvent, StatusView). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- No static files here. Without this, a Debug build on SDK 11 of a project that references
         another Web SDK project fails (the Blazor hot-reload scoped-CSS bundle has no matching endpoint). -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Common/AgenticAI.Common/AgenticAI.Common.csproj" />
  </ItemGroup>

</Project>
