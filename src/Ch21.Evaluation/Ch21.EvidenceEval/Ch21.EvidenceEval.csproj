<Project Sdk="Microsoft.NET.Sdk">

  <!-- Evidence evaluation: five separately named scores (fact, support,
       citation, abstention, action), a paired release gate with intervals,
       and the rule of three. GA packages only. Ch21.FaqEval has its own, simpler
       value check (TextMatch) and does not reference this project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="OllamaSharp" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="cases\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
