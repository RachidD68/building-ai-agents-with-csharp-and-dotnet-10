<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      A console assertion harness, not an xUnit project — matching the book's
      existing "Tests" projects (Ch12.WorkflowTests), so it drops into the
      solution with no extra test packages. The pattern (golden dataset ->
      EvaluateAsync -> AssertAllPassed) moves to xUnit unchanged: turn each
      Case into a [Fact] and let AssertAllPassed throw the assertion.

      The Evaluation surface is [Experimental] under MAAI001 in 1.10; suppress
      it at project scope (the whole project is an Evaluation demo).
    -->
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>
</Project>
