<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hybrid retrieval: BM25 + vector candidates, reciprocal rank fusion, a deterministic
       reranker behind an interface, and HitRate@K / Recall@K per stage on a labeled set
       with fixed vectors. No model, no network. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The corpus model and the word splitter of Ch11.AuthorizedSearch, compiled in as linked files. -->
    <Compile Include="../Ch11.AuthorizedSearch/Corpus.cs" Link="Shared/Corpus.cs" />
    <Compile Include="../Ch11.AuthorizedSearch/HashingEmbedder.cs" Link="Shared/HashingEmbedder.cs" />
    <Content Include="../corpus/**" LinkBase="corpus" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="hybrid-set.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
