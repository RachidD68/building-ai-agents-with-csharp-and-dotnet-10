<Project Sdk="Microsoft.NET.Sdk">

  <!-- Authorized search: the caller's tenant and access level filter the store query,
       so evidence a caller may not read is never ranked, logged, cached or prompted.
       GA packages only. The self-test needs no model and no network. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <PackageReference Include="CommunityToolkit.VectorData.InMemory" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Common/AgenticAI.Common/AgenticAI.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The two-organization corpus is shared by the chapter's projects. -->
    <Content Include="../corpus/**" LinkBase="corpus" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
