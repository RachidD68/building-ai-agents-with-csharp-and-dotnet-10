<Project Sdk="Microsoft.NET.Sdk">

  <!-- Qualification runner: freezes a candidate's identity from the repo
       (global.json, Directory.Packages.props, lock files, compiled prompts,
       skill hashes, data hashes), runs the campaign layers as child processes,
       refuses a layer that selected zero cases, and writes
       qualification-results.json. GA only: OllamaSharp 5.4.25 and the
       Microsoft.Extensions.AI abstractions for the model-identity probe;
       ch. 16's Ch16.SkillLifecycle (project reference) for the skill content
       hash, so a skill is identified by the same bytes ch. 16 approves. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="OllamaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Ch16.SkillsHarnesses/Ch16.SkillLifecycle/Ch16.SkillLifecycle.csproj" />
  </ItemGroup>

</Project>
