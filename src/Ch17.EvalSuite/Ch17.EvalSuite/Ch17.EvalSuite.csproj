<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      The Evaluation API ships in MAF 1.10 but is marked [Experimental]
      across LocalEvaluator, EvalChecks, FunctionEvaluator, EvaluateAsync,
      and AgentEvaluationResults (MAAI001). FoundryEvals and the Foundry
      preview surface add MAAIW001. The APIs exist and work; the diagnostics
      just signal they may change before they stabilise. Suppress at project
      scope (the whole project is an Evaluation demo).
    -->
    <NoWarn>$(NoWarn);MAAI001;MAAIW001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Foundry judge path (gated): AIProjectClient + Azure credential. -->
    <PackageReference Include="Azure.AI.Projects" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Common/AgenticAI.Common/AgenticAI.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
