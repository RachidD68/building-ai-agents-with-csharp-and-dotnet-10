<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Opt out of CPM for implicit Aspire packages. The SDK and Aspire.Hosting
         stay on the version Directory.Packages.props pins for Aspire.Hosting
         (13.6.5); change all three together. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- ASPIRE010 (13.5+): an advisory about the optional Aspire CLI bundle,
         which this sample does not use. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.6.5" />
    <!-- Security fixes: promote transitive vulnerable dependencies to explicit versions -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.14" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Ch17.AspNetCoreHost/Ch17.AspNetCoreHost.csproj" />
  </ItemGroup>

</Project>
