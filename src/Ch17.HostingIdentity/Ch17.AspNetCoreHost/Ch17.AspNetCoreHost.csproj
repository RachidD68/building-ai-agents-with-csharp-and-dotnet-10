<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- One agent behind ASP.NET Core with a validated identity key (tenant +
       subject): JWT bearer, a conversational route over the conversations
       chapter's owned store, a per-caller rate limit and one retry owner.
       Microsoft.Agents.AI.Hosting is a preview package (AddAIAgent); the store
       types are experimental (MAAI001). -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
    <!-- SDK container publishing (.NET 10): dotnet publish /t:PublishContainer.
         The chiseled Ubuntu runtime ships no shell or package manager and runs
         as a non-root user by default. -->
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled</ContainerBaseImage>
    <ContainerRepository>contoso-agent-api</ContainerRepository>
    <ContainerImageTags>1.0.0;latest</ContainerImageTags>
    <ContainerImageFormat>OCI</ContainerImageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Common/AgenticAI.Common/AgenticAI.Common.csproj" />
    <ProjectReference Include="../Ch17.AspireOrchestration/Ch17.AspireOrchestration.ServiceDefaults/Ch17.AspireOrchestration.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The conversations chapter owns the store semantics (ownership key, delete,
         concurrency token); this chapter adds the HTTP identity source and the route. -->
    <Compile Include="../../Ch06.ConversationsMemory/Ch06.SessionOwnership/OwnedSessionStore.cs" Link="Store/OwnedSessionStore.cs" />
  </ItemGroup>

</Project>
