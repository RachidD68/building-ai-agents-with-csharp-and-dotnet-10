<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Contoso snapshot v6, "API and interface". The hosting chapter adds the API
       half: v5's durable claims behind its composition (validated (tid, sub)
       identity key, owned conversations, per-caller quota, one retry owner).
       The interface chapter adds the interface half: the claim's operation
       state as typed, resumable SSE (Ch18.SseStatusStream, GA) and a review
       and approval bound to the exact arguments (ch. 8's digest).
       Microsoft.Agents.AI.Hosting is a preview package (via Ch17.AspNetCoreHost);
       AG-UI is not mapped here (its only cached build needs Hosting 1.5, see
       Ch18.AguiServer). TestHost is used by the self-test only. Simulated
       effects only. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
    <!-- No static files here. Without this, a Debug build on SDK 11 of a project that references
         another Web SDK project fails (the Blazor hot-reload scoped-CSS bundle has no matching endpoint). -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <!-- The previous snapshot, used as it is: DurableClaims, the v2 desk, v4's intake. -->
    <ProjectReference Include="../v5-durable-resume/Contoso.DurableResume.csproj" />
    <!-- The hosting chapter's composition: AgentHost, CallerIdentity, the owned store. -->
    <ProjectReference Include="../../src/Ch17.HostingIdentity/Ch17.AspNetCoreHost/Ch17.AspNetCoreHost.csproj" />
    <!-- The interface chapter's status stream contract (OperationLog, StatusEvent, StatusView). -->
    <ProjectReference Include="../../src/Ch18.StreamingInterfaces/Ch18.SseStatusStream/Ch18.SseStatusStream.csproj" />
  </ItemGroup>

</Project>
