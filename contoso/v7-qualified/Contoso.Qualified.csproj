<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Contoso snapshot v7, "Qualified version". v6 as it is, plus what the
       qualification chapter adds: the release files (candidate manifest,
       capability states, failure journal), a capability gate that keeps a
       disabled capability's routes refused with its recorded reason, a check
       that every mapped route belongs to a declared capability, GET /release,
       and the handoff drill. Microsoft.Agents.AI.Hosting stays a preview
       package (via v6 and Ch17.AspNetCoreHost). TestHost is used by the
       self-test and the drill only. Simulated effects only. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <!-- The previous snapshot, used as it is (and through it v5, v4, v2). -->
    <ProjectReference Include="../v6-api-ui/Contoso.ApiUi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Web SDK already globs *.json as Content; copy the release files next to the binary. -->
    <Content Update="release/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
