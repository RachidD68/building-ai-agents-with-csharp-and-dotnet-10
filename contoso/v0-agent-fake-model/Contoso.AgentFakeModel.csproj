<Project Sdk="Microsoft.NET.Sdk">

  <!-- Contoso snapshot v0, "Agent and fake model": the expense-policy agent
       answers questions (no tools, no effects), streamed with an explicit
       terminal status, and its messages and cancellation are tested offline
       with a fake IChatClient. A console app, like the later v2 snapshot. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- GA-only provider switch: Ollama by default. -->
    <ProjectReference Include="../../src/Common/AgenticAI.Common/AgenticAI.Common.csproj" />
    <!-- The fake model, for the self-test. -->
    <ProjectReference Include="../../src/Common/AgenticAI.Testing/AgenticAI.Testing.csproj" />
  </ItemGroup>

  <!-- The first-agent chapter's policy agent and run classifier, used as they are. -->
  <ItemGroup>
    <Compile Include="../../src/Ch04.FirstAgent/Ch04.BasicAgent/ContosoPolicy.cs" Link="Linked/ContosoPolicy.cs" />
    <Compile Include="../../src/Ch04.FirstAgent/Ch04.StreamingAgent/AgentRuns.cs" Link="Linked/AgentRuns.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
